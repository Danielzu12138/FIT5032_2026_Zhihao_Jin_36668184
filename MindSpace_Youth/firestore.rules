rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null &&
        request.auth.token.email_verified == true;
    }

    // Admin status is read from a protected Firestore profile. A public client
    // cannot create or update its own profile to become an admin.
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());

      // A profile is activated only after the account has verified its email.
      allow create: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.role == 'young_user' &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.keys().hasOnly([
          'name',
          'email',
          'role',
          'uid',
          'createdAt'
        ]);

      allow update: if isAdmin() ||
        (signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role == resource.data.role);

      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;

      allow read: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid);

      allow update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;

      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /saved_resources/{resourceId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;

      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;

      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
